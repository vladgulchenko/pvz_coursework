<UserControl x:Class="Pvz.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#183D44" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#9FDED0" CornerRadius="5" Padding="10,6"><TextBlock Text="ПВЗ" FontSize="18" FontWeight="Bold" Foreground="#183D44"/></Border>
                    <TextBlock Text="Управление заказами" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,24,0">
                    <TextBlock Text="{Binding CurrentUser.Name}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CurrentUser.RoleText}" Foreground="#ABC9CB" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Выйти" Command="{Binding LogoutCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="Logout"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="26,22,26,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Заказы" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="Приём и обработка отправлений" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Сотрудники" Command="{Binding EmployeesCommand}" Visibility="{Binding IsAdministrator, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" AutomationProperties.AutomationId="Employees"/>
                    <Button Content="Места хранения" Command="{Binding LocationsCommand}" Visibility="{Binding IsAdministrator, Converter={StaticResource BoolVisibility}}" Margin="0,0,16,0" AutomationProperties.AutomationId="Locations"/>
                    <Button Content="+ Новый заказ" Command="{Binding NewOrderCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="NewOrder"/>
                </StackPanel>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,18">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TotalCount}" FontSize="27" FontWeight="SemiBold" Margin="0,0,14,0"/><TextBlock Text="Заказов в выборке" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AwaitingCount}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,14,0"/><TextBlock Text="Ожидают выдачи" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding OverdueCount}" FontSize="27" FontWeight="SemiBold" Foreground="#AF5F24" Margin="0,0,14,0"/><TextBlock Text="С истёкшим сроком" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Grid.Row="2" Text="{Binding Message}" Style="{StaticResource Feedback}" Margin="0,0,0,10" AutomationProperties.AutomationId="MainMessage"/>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="5*" MinWidth="380"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="175"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" ToolTip="Поиск по части номера заказа" AutomationProperties.AutomationId="SearchNumber"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Margin="8,0" AutomationProperties.AutomationId="StatusFilter"/>
                            <Button Grid.Column="2" Content="Найти" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="SearchOrders"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutomationProperties.AutomationId="OrdersGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="120"/>
                                    <DataGridTextColumn Header="Получатель" Binding="{Binding RecipientName}" Width="*" MinWidth="125"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="145"/>
                                    <DataGridTemplateColumn Header="Хранение до" Width="140">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding StorageUntilLocal, StringFormat=dd.MM.yy HH:mm}" FontSize="12"/><TextBlock Text="{Binding OverdueText}" Foreground="#A34F1B" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Заказы не найдены. Измените поиск или зарегистрируйте новый заказ." Foreground="{StaticResource Muted}" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TotalCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Поиск по номеру · обновление каждые 30 секунд" Foreground="{StaticResource Muted}" FontSize="11" Margin="16,12"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TextBlock Text="Выберите заказ, чтобы посмотреть состав, историю и доступные операции." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35" TextAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDetails}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDetails, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="22">
                                <Grid><TextBlock Text="{Binding Details.Summary.Number, StringFormat=Заказ № {0}}" FontSize="22" FontWeight="SemiBold" Margin="0,0,90,0"/><Button Content="Изменить" Command="{Binding EditOrderCommand}" HorizontalAlignment="Right" Padding="10,6"/></Grid>
                                <TextBlock Text="{Binding Details.Summary.StatusText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding Details.Summary.OverdueText}" Foreground="#A34F1B" FontWeight="SemiBold"/>
                                <TextBlock Text="Получатель" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding Details.Summary.RecipientName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Details.Summary.RecipientPhone}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Место" Style="{StaticResource Label}"/><TextBlock Text="{Binding Details.Summary.Location}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Хранение до" Style="{StaticResource Label}"/><TextBlock Text="{Binding Details.Summary.StorageUntilLocal, StringFormat=dd.MM.yyyy HH:mm}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Details.Summary.ReceivedAtLocal, StringFormat=Поступление: {0:dd.MM.yyyy HH:mm}}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                                <TextBlock Text="СОСТАВ ЗАКАЗА" Style="{StaticResource Label}" Margin="0,22,0,10" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Details.Items}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><TextBlock Text="{Binding Name}" Margin="0,0,60,0"/><TextBlock Text="{Binding Quantity, StringFormat={}{0} шт.}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,18"/>
                                <Button Content="Выдать заказ" Command="{Binding IssueCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="IssueOrder"/>
                                <StackPanel Visibility="{Binding CanStartReturn, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Причина возврата" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.AutomationId="ReturnReason"/>
                                    <TextBlock Text="Место для возврата" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding ReturnLocation}" DisplayMemberPath="Label" AutomationProperties.AutomationId="ReturnLocation"/>
                                    <Button Content="Принять к возврату" Command="{Binding StartReturnCommand}" Margin="0,10,0,0" AutomationProperties.AutomationId="StartReturn"/>
                                </StackPanel>
                                <Button Content="Завершить возврат" Command="{Binding CompleteReturnCommand}" Margin="0,10,0,0" Visibility="{Binding CanCompleteReturn, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CompleteReturn"/>
                                <TextBlock Text="ИСТОРИЯ ОБРАБОТКИ" Style="{StaticResource Label}" Margin="0,25,0,12" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Details.History}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="2,0,0,0" Padding="12,0,0,14">
                                            <StackPanel><TextBlock Text="{Binding Transition}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding ChangedAtLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding EmployeeName}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReturnReason}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
