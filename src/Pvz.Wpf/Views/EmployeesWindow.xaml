<Window x:Class="Pvz.Wpf.Views.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Сотрудники" Width="1040" Height="720" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner">
    <Grid Margin="26" IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid><TextBlock Text="Сотрудники" FontSize="26" FontWeight="SemiBold"/><Button Content="+ Новый сотрудник" Command="{Binding NewCommand}" HorizontalAlignment="Right"/></Grid>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Feedback}" Margin="0,16" AutomationProperties.AutomationId="EmployeesMessage"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding Selected}" AutomationProperties.AutomationId="EmployeesGrid">
                <DataGrid.Columns><DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/><DataGridTextColumn Header="Роль" Binding="{Binding RoleText}" Width="130"/><DataGridTextColumn Header="Доступ" Binding="{Binding ActivityText}" Width="95"/></DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Имя" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.AutomationId="EmployeeName"/>
                    <TextBlock Text="Логин" Style="{StaticResource Label}"/><TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.AutomationId="EmployeeLogin"/>
                    <TextBlock Text="Роль" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" DisplayMemberPath="Label" AutomationProperties.AutomationId="EmployeeRole"/>
                    <CheckBox Content="Учётная запись активна" IsChecked="{Binding Active}" Margin="0,18,0,8"/>
                    <TextBlock Text="Новый пароль (от 8 символов)" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordInput" MaxLength="128" AutomationProperties.AutomationId="EmployeePassword"/>
                    <TextBlock Text="Для новой записи пароль обязателен. Для существующей пароль меняется отдельной кнопкой." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
                    <Button Content="Сохранить сотрудника" Click="Save" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveEmployee"/>
                    <Button Content="Установить новый пароль" Click="ResetPassword" Margin="0,8,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
