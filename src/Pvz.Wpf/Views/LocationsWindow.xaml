<Window x:Class="Pvz.Wpf.Views.LocationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Места хранения" Width="780" Height="580" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="26" IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid><TextBlock Text="Места хранения" FontSize="26" FontWeight="SemiBold"/><Button Content="+ Новое место" Command="{Binding NewCommand}" HorizontalAlignment="Right"/></Grid>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Feedback}" Margin="0,16" AutomationProperties.AutomationId="LocationsMessage"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding Selected}" AutomationProperties.AutomationId="LocationsGrid"><DataGrid.Columns><DataGridTextColumn Header="Стеллаж" Binding="{Binding Rack}" Width="*"/><DataGridTextColumn Header="Ячейка" Binding="{Binding Cell}" Width="*"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Размещение" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Стеллаж" Style="{StaticResource Label}"/><TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.AutomationId="Rack"/>
                <TextBlock Text="Ячейка" Style="{StaticResource Label}"/><TextBox Text="{Binding Cell, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.AutomationId="Cell"/>
                <TextBlock Text="В одной ячейке может храниться несколько заказов. Занятое место удалить нельзя." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16"/>
                <Button Content="Сохранить место" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveLocation"/>
                <Button Content="Удалить выбранное" Command="{Binding DeleteCommand}" Margin="0,8,0,0"/>
            </StackPanel></Border>
        </Grid>
    </Grid>
</Window>
